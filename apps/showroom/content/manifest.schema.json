{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://one.firmmit.com/schemas/showroom-manifest/1.0.json",
  "title": "FIRMMIT ONE TV 쇼룸 콘텐츠 목록 v1",
  "description": "방문객 화면에 나갈 항목. 승인 → 게시 → 표시 → 만료·회수 흐름을 이 파일 하나로 관리한다. 내부 정보(이메일·전화번호·시트 ID·직원 전용 주소)는 넣지 않는다 — scripts/check-content.mjs 가 빌드에서 막는다.",
  "type": "object",
  "additionalProperties": false,
  "required": ["manifest_version", "release", "languages", "default_language", "autoplay_seconds", "idle_resume_seconds", "links", "items"],
  "properties": {
    "manifest_version": { "const": "1.0" },
    "release": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "note"],
      "properties": {
        "status": {
          "enum": ["sample", "approved"],
          "description": "sample = 아직 승인된 콘텐츠가 아님(G10). 화면에 '샘플 — 승인 전' 을 고정 표시한다."
        },
        "note": { "$ref": "#/$defs/text" }
      }
    },
    "languages": {
      "type": "array",
      "minItems": 1,
      "maxItems": 4,
      "items": { "enum": ["ko", "en", "uz-Latn", "ru"] },
      "description": "최종 언어 목록은 FIRMMIT 결정 대기. 지금은 ko·en 을 기본으로 둔다."
    },
    "default_language": { "enum": ["ko", "en", "uz-Latn", "ru"] },
    "autoplay_seconds": { "type": "integer", "minimum": 5, "maximum": 300 },
    "idle_resume_seconds": {
      "type": "integer",
      "minimum": 10,
      "maximum": 3600,
      "description": "입력이 이만큼 없으면 자동재생으로 돌아간다"
    },
    "links": {
      "type": "array",
      "maxItems": 10,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "url", "label"],
        "properties": {
          "id": { "type": "string", "pattern": "^[a-z][a-z0-9-]{1,20}$" },
          "url": { "type": "string", "description": "공개 주소만. 허용 목록은 check-content.mjs 에 있다." },
          "label": { "$ref": "#/$defs/text" }
        }
      }
    },
    "items": { "type": "array", "minItems": 1, "maxItems": 50, "items": { "$ref": "#/$defs/item" } }
  },
  "$defs": {
    "text": {
      "type": "object",
      "additionalProperties": false,
      "description": "언어별 한 줄. manifest.languages 의 모든 언어가 있어야 한다.",
      "properties": {
        "ko": { "type": "string", "minLength": 1, "maxLength": 400 },
        "en": { "type": "string", "minLength": 1, "maxLength": 400 },
        "uz-Latn": { "type": "string", "minLength": 1, "maxLength": 400 },
        "ru": { "type": "string", "minLength": 1, "maxLength": 400 }
      }
    },
    "lines": {
      "type": "object",
      "additionalProperties": false,
      "description": "언어별 여러 줄",
      "properties": {
        "ko": { "$ref": "#/$defs/lineList" },
        "en": { "$ref": "#/$defs/lineList" },
        "uz-Latn": { "$ref": "#/$defs/lineList" },
        "ru": { "$ref": "#/$defs/lineList" }
      }
    },
    "lineList": { "type": "array", "minItems": 1, "maxItems": 6, "items": { "type": "string", "minLength": 1, "maxLength": 200 } },
    "item": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "type", "status", "approved_by", "approved_at", "publish_from", "expires_at", "title"],
      "properties": {
        "id": { "type": "string", "pattern": "^S[0-9]{2}$" },
        "type": { "enum": ["cover", "section", "links"] },
        "status": {
          "enum": ["draft", "approved", "published", "expired", "withdrawn"],
          "description": "published 이고 게시 기간 안일 때만 화면에 나온다. 오프라인이어도 만료된 항목은 표시하지 않는다."
        },
        "approved_by": {
          "type": "string",
          "minLength": 1,
          "maxLength": 60,
          "description": "직책만 적는다(실명 금지). release.status=sample 이면 반드시 \"SAMPLE\"."
        },
        "approved_at": { "type": ["string", "null"], "pattern": "^\\d{4}-\\d{2}-\\d{2}$" },
        "publish_from": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" },
        "expires_at": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" },
        "title": { "$ref": "#/$defs/text" },
        "subtitle": { "$ref": "#/$defs/text" },
        "body": { "$ref": "#/$defs/lines" },
        "media": { "type": "string", "pattern": "^media/[A-Za-z0-9._-]+$" },
        "links": { "type": "array", "maxItems": 3, "items": { "type": "string" } }
      }
    }
  }
}
