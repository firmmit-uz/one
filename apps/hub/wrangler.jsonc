// FIRMMIT ONE 허브 v1 — Cloudflare Worker 설정
// 자리표시자(<...>)는 배포 담당자가 README 배포 안내서에 따라 채움. 비밀값은 넣지 않음.
{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "fm-one-hub",
  "main": "src/index.ts",
  "compatibility_date": "2026-09-01",
  "assets": {
    "directory": "./public",
    "run_worker_first": ["/api/*"],
    "not_found_handling": "single-page-application"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "fm-one-hub",
      "database_id": "<D1_DATABASE_ID>",
      "migrations_dir": "migrations"
    }
  ],
  "vars": {
    "ENVIRONMENT": "production",
    "ACCESS_TEAM": "<TEAM>",
    "ACCESS_AUD": "<AUD>",
    "ALLOWED_ORIGIN": "https://<허브 주소>",
    // WP1 그룹 동기화. 비워 두거나 자리표시자면 자동 동기화를 실행하지 않고 수동 입력을 쓴다.
    // 짝이 되는 CF_API_TOKEN 은 Worker Secret (읽기 전용 권한만) — 여기에 넣지 않는다.
    "CF_ACCOUNT_ID": "<CF_ACCOUNT_ID>",
    // WP3 외부 토큰 갱신. 기본 꺼짐 — 켜기 전 조건은 README 배포 안내서를 따른다.
    // "true" 일 때만 켜진다. 짝이 되는 암호화 키 TOKEN_KEY_V1 은 Worker Secret.
    "TOKEN_REFRESH_ENABLED": "false",
    // R3 CCTV 보기. 기본 꺼짐 — "true" 일 때만 켜진다.
    // CCTV_RELAY_ORIGIN 은 사내 CCTV 중계 서버 주소(https). 자리표시자이면 꺼진 것으로 본다.
    // CCTV_RELAY_AUTH 는 중계 서버에 자신을 밝히는 방법: none | basic | cf-access.
    //   basic     → CCTV_RELAY_USER · CCTV_RELAY_PASS
    //   cf-access → CCTV_RELAY_CF_ID · CCTV_RELAY_CF_SECRET
    //   넷 다 Worker Secret — 여기에 넣지 않는다. 값이 없으면 재생을 막는다(익명 호출 금지).
    // 카메라 RTSP 주소·계정은 중계 서버에만 두고 허브에 넣지 않는다.
    "CCTV_ENABLED": "false",
    "CCTV_RELAY_ORIGIN": "<CCTV_RELAY_ORIGIN>",
    "CCTV_RELAY_AUTH": "none"
  },
  // */5 가용성 점검·내부 KPI · */15 Access 그룹 동기화 · 매시 정각 토큰 갱신
  // (계정 Cron 합계는 README 4.1 참고)
  "triggers": {
    "crons": ["*/5 * * * *", "*/15 * * * *", "0 * * * *"]
  },
  "observability": {
    "enabled": true
  },
  "env": {
    "development": {
      "name": "fm-one-hub-dev",
      "d1_databases": [
        {
          "binding": "DB",
          "database_name": "fm-one-hub-dev",
          "database_id": "<D1_DATABASE_ID_DEV>",
          "migrations_dir": "migrations"
        }
      ],
      "vars": {
        "ENVIRONMENT": "development",
        "ACCESS_TEAM": "<TEAM>",
        "ACCESS_AUD": "<AUD>",
        "ALLOWED_ORIGIN": "http://localhost:8787",
        "DEV_FAKE_IDENTITY": "dev-admin@example.invalid"
      },
      "triggers": {
        "crons": []
      }
    }
  }
}
